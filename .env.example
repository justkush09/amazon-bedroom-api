# --- Database ---
POSTGRES_USER=bedroom_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bedroom_products
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bedroom_user:change_me@db:5432/bedroom_products

# --- Amazon Product Advertising API (PA-API 5.0) ---
PAAPI_ACCESS_KEY=your_access_key
PAAPI_SECRET_KEY=your_secret_key
PAAPI_PARTNER_TAG=your-partner-tag-20
PAAPI_PARTNER_TYPE=Associates
PAAPI_HOST=webservices.amazon.com
PAAPI_REGION=us-east-1
PAAPI_MARKETPLACE=www.amazon.com

# --- App ---
APP_ENV=production
LOG_LEVEL=INFO
ITEMS_PER_SUBCATEGORY=10
PAAPI_REQUEST_DELAY_SECONDS=1.1
